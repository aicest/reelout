{
  "name": "@reelout/gitlab",
  "version": "0.4.0",
  "description": "GitLab integration for automating releases.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aicest/reelout.git",
    "directory": "packages/gitlab"
  },
  "license": "MIT",
  "type": "module",
  "imports": {},
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "module": "./src/index.ts",
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "module": "./src/*.ts",
      "development": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "./dist",
    "./src"
  ],
  "scripts": {
    "build": "vite build --ssr --sourcemap",
    "dev": "vite build --ssr --watch"
  },
  "dependencies": {
    "@gitbeaker/rest": "catalog:",
    "@reelout/core": "workspace:^"
  },
  "engines": {
    "node": ">=24.15"
  }
}

{
  "name": "@reelout/npm",
  "version": "0.5.0",
  "description": "NPM integration for publishing packages.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aicest/reelout.git",
    "directory": "packages/npm"
  },
  "license": "MIT",
  "type": "module",
  "imports": {},
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "module": "./src/index.ts",
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "module": "./src/*.ts",
      "development": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "./dist",
    "./src"
  ],
  "scripts": {
    "build": "vite build --ssr --sourcemap",
    "dev": "vite build --ssr --watch"
  },
  "dependencies": {
    "@npmcli/config": "catalog:",
    "@reelout/core": "workspace:^",
    "@reelout/github": "workspace:^",
    "@reelout/gitlab": "workspace:^",
    "@yarnpkg/core": "catalog:",
    "@yarnpkg/fslib": "catalog:",
    "@yarnpkg/plugin-npm": "catalog:",
    "consola": "catalog:",
    "glob": "catalog:",
    "hosted-git-info": "catalog:",
    "lodash-es": "catalog:",
    "semver": "catalog:",
    "sort-package-json": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/hosted-git-info": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/npmcli__config": "catalog:",
    "@types/semver": "catalog:"
  },
  "engines": {
    "node": ">=24.15"
  }
}

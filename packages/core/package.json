{
  "name": "@reelout/core",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aicest/reelout.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*/index.ts"
    ]
  },
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "module": "./src/index.ts",
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "module": "./src/*.ts",
      "development": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "./dist",
    "./src"
  ],
  "scripts": {
    "build": "vite build --ssr --sourcemap",
    "dev": "vite build --ssr --watch"
  },
  "dependencies": {
    "consola": "catalog:",
    "conventional-commits-parser": "catalog:",
    "minimatch": "catalog:",
    "prettier": "catalog:",
    "semver": "catalog:"
  },
  "devDependencies": {
    "@types/semver": "catalog:"
  },
  "engines": {
    "node": ">=24.15"
  }
}
